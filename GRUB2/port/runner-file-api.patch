+    va_list ap;
+    char path[256];
+    grub_file_t file;
+
+    va_start(ap, fmt);
+    grub_vsnprintf(path, sizeof(path), fmt, ap);
+    va_end(ap);
+
+    file = grub_file_open(path, GRUB_FILE_TYPE_NONE);
+    if (!file)
+    {
+        grub_errno = GRUB_ERR_NONE;
+        return 0;
+    }
+
+    grub_file_close(file);
+    return 1;
